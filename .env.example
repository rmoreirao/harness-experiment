# Copy this file to .env and explicitly choose one provider.
# The CLI loads .env from the directory where you launch it.
# Existing process environment variables take precedence.

# Copilot uses SDK sign-in; BYOK requires its own endpoint and key.
# An ambient OPENAI_BASE_URL never switches a Copilot session to BYOK.
HARNESS_PROVIDER=copilot

# BYOK only: OpenAI-compatible API base, including /v1 when required, not /responses.
# Example: https://api.openai.com/v1
OPENAI_BASE_URL=

# Canonical model identifier used by the Copilot runtime.
HARNESS_MODEL=

# Optional deployment identifier when it differs from HARNESS_MODEL.
HARNESS_WIRE_MODEL=

# BYOK only: keep the real key in the ignored .env file, never in this example.
# A different key variable can be selected with provider.apiKeyEnv in version 4 config.
OPENAI_API_KEY=

# Optional key for an explicitly configured Brave search connector.
BRAVE_SEARCH_API_KEY=

# Persisted MCP env/header values must be references, never literal credentials:
# "headers": { "Authorization": "${env:DOCS_AUTHORIZATION}" }
# Set DOCS_AUTHORIZATION in the host environment to the complete header value.
# References are resolved only for the in-memory SDK workspace configuration.
