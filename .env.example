# Copy this file to .env and fill in all three values.
# The CLI loads .env from the directory where you launch it.
# Existing process environment variables take precedence.

# OpenAI-compatible API base URL, including /v1 when required, not /responses.
# Example: https://api.openai.com/v1
OPENAI_BASE_URL=

# Model identifier available on your endpoint.
HARNESS_MODEL=

# Keep the real key in the ignored .env file, never in this example.
OPENAI_API_KEY=
